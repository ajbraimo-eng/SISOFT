# Porta do Isoft
PORT=3000

# 0.0.0.0 = acessível na rede / servidor externo
HOST=0.0.0.0

# URL pública (domínio ou IP externo), sem barra no fim
# Exemplos:
# PUBLIC_URL=http://192.168.1.50:3000
# PUBLIC_URL=https://isoft.empresa.com
PUBLIC_URL=

# Produção (obrigatório em servidor público)
NODE_ENV=production

# Segredo de autenticação (mín. 32 caracteres). Se vazio, gera .auth-secret
# AUTH_SECRET=cole-aqui-um-segredo-longo-e-aleatorio

# Nunca em produção na Internet:
# ALLOW_RECOVERY_PREVIEW=0
# MAIL_DEV_MODE=0
# SMS_DEV_MODE=0

# --- Email (recuperação de senha) ---
# SMTP (ex.: Gmail com palavra-passe de aplicação)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=sisoftcenter@gmail.com
# SMTP_PASS=sua-app-password
# SMTP_FROM=sisoftcenter@gmail.com
# SMTP_SECURE=false
#
# Ou webhook HTTP POST { to, subject, text }
# EMAIL_WEBHOOK_URL=

# --- SMS (recuperação de senha) ---
# Twilio: https://console.twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM=+1xxxxxxxx
#
# Ou webhook HTTP POST { to, phone, message, text }
# SMS_WEBHOOK_URL=
