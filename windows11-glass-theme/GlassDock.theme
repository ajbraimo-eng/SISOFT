[Theme]
DisplayName=Glass Dock
ThemeId={A1B2C3D4-E5F6-7890-ABCD-EF1234567890}
Author=Glass Dock
Preview=assets\wallpaper.bmp

[Control Panel\Desktop]
Wallpaper=%ThemeDir%assets\wallpaper.bmp
TileWallpaper=0
WallpaperStyle=10
Pattern=
ScreenSaveActive=0

[VisualStyles]
Path=%SystemRoot%\Resources\Themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
ColorizationColor=0xC4A8D4F0
TransparencyEnabled=1
SystemMode=Light
AppMode=Light

[MasterThemeSelector]
MTSM=RJSPBS

[Sounds]
; Scheme.Default=

[Cursor]
; Use Windows defaults

[Slideshow]
Interval=0
Shuffle=0
